    {
      "id": "806d3123-9311-434f-a7e1-4dde515e7780",
      "name": "Susun Salinan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Mengubah isi 4 tab Data Klinik menjadi 4 baris salinan (satu baris per tab) untuk data table \"Salinan Data Klinik\".\n// Bot Balas Chat membaca salinan ini, jadi tidak perlu membuka Google Sheets setiap ada chat.\nconst waktu = new Date().toISOString();\nconst ambil = n => $(n).all().map(i => i.json).filter(r => r && Object.keys(r).length > 0);\n// Kalau tab Harga terbaca kosong, kemungkinan ada gangguan: salinan lama dipertahankan.\nif (!ambil('Salin Harga').length) throw new Error('Tab Harga terbaca kosong, salinan lama dipertahankan');\nreturn [\n  ['harga', 'Salin Harga'], ['jadwal', 'Salin Jadwal'], ['promo', 'Salin Promo'], ['info', 'Salin Info'],\n].map(([tab, n]) => ({ json: { tab, isi: JSON.stringify(ambil(n)), diperbarui: waktu } }));"
      },
      "executeOnce": true
    },
    {
      "id": "215e91fe-6666-4df5-b6a7-20aa403b13b7",
      "name": "Simpan Salinan",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1580,
        100
      ],
      "parameters": {
        "resource": "row",
        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_CLINIC_DATA_COPY_TABLE_ID",
          "cachedResultName": "Salinan Data Klinik"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "tab",
              "condition": "eq",
              "keyValue": "={{ $json.tab }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "tab": "={{ $json.tab }}",
            "isi": "={{ $json.isi }}",
            "diperbarui": "={{ $json.diperbarui }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "tab",
              "displayName": "tab",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "readOnly": false,
              "removed": false
            },
            {
              "id": "isi",
              "displayName": "isi",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "readOnly": false,
              "removed": false
            },
            {
              "id": "diperbarui",
              "displayName": "diperbarui",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "readOnly": false,
              "removed": false
            }
          ]
        },
        "options": {}
      }
    },
